#!/bin/sh
# Se ejecuta dentro del chroot al construir la ISO.
set -e

# ---- Identidad del sistema: Atherium ----
cat > /etc/os-release <<'EOF'
PRETTY_NAME="Atherium"
NAME="Atherium"
VERSION_ID="1.0"
VERSION="1.0 (Nebula)"
VERSION_CODENAME=nebula
ID=atherium
ID_LIKE=debian
HOME_URL="https://github.com/galaxiumos"
SUPPORT_URL="https://github.com/galaxiumos"
BUG_REPORT_URL="https://github.com/galaxiumos"
EOF

echo "Atherium 1.0 \\n \\l" > /etc/issue
echo "Atherium 1.0" > /etc/issue.net
cat > /etc/lsb-release <<'EOF'
DISTRIB_ID=Atherium
DISTRIB_RELEASE=1.0
DISTRIB_CODENAME=nebula
DISTRIB_DESCRIPTION="Atherium 1.0"
EOF

echo "atherium" > /etc/hostname

# ---- Neofetch (no esta en los repos de Debian 13) ----
# Se descarga la version 7.1.0 (MIT). Si falla, se crea un respaldo con fastfetch.
if curl -fsSL --retry 3 -o /usr/local/bin/neofetch \
    https://raw.githubusercontent.com/dylanaraps/neofetch/7.1.0/neofetch \
    && head -n1 /usr/local/bin/neofetch | grep -q bash; then
    chmod 755 /usr/local/bin/neofetch
else
    echo "AVISO: no se pudo descargar neofetch, usando fastfetch" >&2
    sed 's/\${c[0-9]}//g' /etc/atherium/logo.ascii > /etc/atherium/logo.plain
    cat > /usr/local/bin/neofetch <<'EOF'
#!/bin/sh
exec fastfetch --logo-type file-raw --logo /etc/atherium/logo.plain "$@"
EOF
    chmod 755 /usr/local/bin/neofetch
fi

# ---- Neofetch: configuracion global para cualquier usuario ----
mkdir -p /etc/neofetch
cp /etc/skel/.config/neofetch/config.conf /etc/neofetch/config.conf || true

# ---- Estetica tipo macOS: WhiteSur (iconos, GTK, cursores) ----
# No estan en los repos de Debian: se descargan de GitHub. Si algo falla se usa Arc/Papirus.
GTK_THEME="Arc-Dark"
XFWM_THEME="Arc-Dark"
ICON_THEME="Papirus-Dark"
CURSOR_THEME="Adwaita"
WORK="$(mktemp -d)"

if git clone --depth 1 https://github.com/vinceliuice/WhiteSur-icon-theme.git "$WORK/icons" \
    && (cd "$WORK/icons" && ./install.sh -d /usr/share/icons) \
    && [ -d /usr/share/icons/WhiteSur-dark ]; then
    ICON_THEME="WhiteSur-dark"
else
    echo "AVISO: no se pudo instalar WhiteSur-icon-theme, se usa Papirus-Dark" >&2
fi

if git clone --depth 1 https://github.com/vinceliuice/WhiteSur-gtk-theme.git "$WORK/gtk" \
    && (cd "$WORK/gtk" && ./install.sh -d /usr/share/themes -c Dark -o normal) \
    && [ -d /usr/share/themes/WhiteSur-Dark ]; then
    GTK_THEME="WhiteSur-Dark"
    if [ -d /usr/share/themes/WhiteSur-Dark/xfwm4 ]; then
        XFWM_THEME="WhiteSur-Dark"
    fi
else
    echo "AVISO: no se pudo instalar WhiteSur-gtk-theme, se usa Arc-Dark" >&2
fi

if git clone --depth 1 https://github.com/vinceliuice/WhiteSur-cursors.git "$WORK/cursors" \
    && (cd "$WORK/cursors" && ./install.sh) \
    && [ -d /usr/share/icons/WhiteSur-cursors ]; then
    CURSOR_THEME="WhiteSur-cursors"
else
    echo "AVISO: no se pudo instalar WhiteSur-cursors, se usa Adwaita" >&2
fi
rm -rf "$WORK"

echo "Temas elegidos: gtk=$GTK_THEME xfwm4=$XFWM_THEME iconos=$ICON_THEME cursor=$CURSOR_THEME"

# Sustituir los marcadores de las plantillas de configuracion
for f in \
    /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml \
    /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml \
    /etc/dconf/db/local.d/00-atherium
do
    sed -i "s/@GTK_THEME@/$GTK_THEME/g; s/@XFWM_THEME@/$XFWM_THEME/g; s/@ICON_THEME@/$ICON_THEME/g; s/@CURSOR_THEME@/$CURSOR_THEME/g" "$f"
done

# Cursor tambien para el cursor por defecto de X
mkdir -p /usr/share/icons/default
printf '[Icon Theme]\nInherits=%s\n' "$CURSOR_THEME" > /usr/share/icons/default/index.theme

# ---- Valores por defecto de dconf (plank, GTK) ----
if command -v dconf >/dev/null 2>&1; then
    mkdir -p /etc/dconf/profile
    printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
    dconf update || true
fi

# ---- Greeter de LightDM ----
mkdir -p /etc/lightdm/lightdm-gtk-greeter.conf.d
cat > /etc/lightdm/lightdm-gtk-greeter.conf.d/50-atherium.conf <<EOF
[greeter]
background=/usr/share/backgrounds/atherium/wallpaper.png
theme-name=$GTK_THEME
icon-theme-name=$ICON_THEME
cursor-theme-name=$CURSOR_THEME
font-name=Inter 11
indicators=~host;~spacer;~clock;~spacer;~session;~a11y;~power
position=50%,center
EOF

# ---- Permisos de scripts ----
chmod +x /usr/local/bin/atherium-session-init 2>/dev/null || true

# ---- Shell: neofetch al abrir una terminal interactiva ----
cat >> /etc/skel/.bashrc <<'EOF'

# Atherium: mostrar el logo al abrir la terminal
if [ -t 1 ] && command -v neofetch >/dev/null 2>&1 && [ -z "$ATHERIUM_NEOFETCH_SHOWN" ]; then
    export ATHERIUM_NEOFETCH_SHOWN=1
    neofetch
fi
alias ll='ls -lah --color=auto'
EOF
