#!/bin/sh
# Se ejecuta dentro del chroot al construir la ISO (Ubuntu 24.04 + GNOME).
set -e
export DEBIAN_FRONTEND=noninteractive

# ---- Neofetch (viene en universe; si faltara se descarga) ----
if ! command -v neofetch >/dev/null 2>&1; then
    curl -fsSL --retry 3 -o /usr/local/bin/neofetch \
        https://raw.githubusercontent.com/dylanaraps/neofetch/7.1.0/neofetch \
        && chmod 755 /usr/local/bin/neofetch \
        || echo "AVISO: neofetch no disponible" >&2
fi
mkdir -p /etc/neofetch
cp /etc/skel/.config/neofetch/config.conf /etc/neofetch/config.conf || true

# ---- Firefox: el paquete de Ubuntu es un stub de snap; se usa el PPA de Mozilla (deb) ----
BROWSER_DESKTOP="org.gnome.Epiphany.desktop"
if apt-get update -qq && add-apt-repository -y ppa:mozillateam/ppa; then
    cat > /etc/apt/preferences.d/mozilla-firefox <<'EOF'
Package: *
Pin: release o=LP-PPA-mozillateam
Pin-Priority: 1001

Package: firefox*
Pin: release o=Ubuntu
Pin-Priority: -1
EOF
    if apt-get update -qq && apt-get install -y firefox firefox-locale-es; then
        BROWSER_DESKTOP="firefox.desktop"
    else
        echo "AVISO: no se pudo instalar Firefox, se usa Epiphany" >&2
    fi
else
    echo "AVISO: no se pudo anadir el PPA de Mozilla, se usa Epiphany" >&2
fi

# ---- Estetica tipo macOS: WhiteSur (iconos, GTK + shell, cursores) ----
# No estan en los repos de Ubuntu: se descargan de GitHub. Si algo falla se usa Yaru.
GTK_THEME="Yaru-dark"
SHELL_THEME="Yaru-dark"
BASE_ICONS="Yaru"
CURSOR_THEME="Adwaita"
WORK="$(mktemp -d)"

if git clone --depth 1 https://github.com/vinceliuice/WhiteSur-icon-theme.git "$WORK/icons" \
    && (cd "$WORK/icons" && ./install.sh -d /usr/share/icons) \
    && [ -d /usr/share/icons/WhiteSur-dark ]; then
    BASE_ICONS="WhiteSur-dark"
else
    echo "AVISO: no se pudo instalar WhiteSur-icon-theme, se usa Yaru" >&2
fi

# El instalador necesita USER y TERM (en el chroot no existen y salia en silencio)
if git clone --depth 1 https://github.com/vinceliuice/WhiteSur-gtk-theme.git "$WORK/gtk" \
    && (cd "$WORK/gtk" && env USER=root LOGNAME=root HOME=/root TERM=xterm-256color \
        bash -x ./install.sh -d /usr/share/themes -c Dark -o normal < /dev/null > "$WORK/gtk.log" 2>&1) \
    && [ -d /usr/share/themes/WhiteSur-Dark ]; then
    GTK_THEME="WhiteSur-Dark"
    [ -d /usr/share/themes/WhiteSur-Dark/gnome-shell ] && SHELL_THEME="WhiteSur-Dark"
else
    echo "AVISO: no se pudo instalar WhiteSur-gtk-theme, se usa Yaru-dark" >&2
    [ -f "$WORK/gtk.log" ] && { echo "--- ultimas lineas del instalador ---" >&2; tail -n 40 "$WORK/gtk.log" >&2; }
fi

if git clone --depth 1 https://github.com/vinceliuice/WhiteSur-cursors.git "$WORK/cursors" \
    && (cd "$WORK/cursors" && ./install.sh) \
    && [ -d /usr/share/icons/WhiteSur-cursors ]; then
    CURSOR_THEME="WhiteSur-cursors"
else
    echo "AVISO: no se pudo instalar WhiteSur-cursors, se usa Adwaita" >&2
fi
rm -rf "$WORK"

# ---- Tema de iconos "Atherium": hereda de WhiteSur y cambia el boton de apps por el logo ----
ICON_DIR=/usr/share/icons/Atherium
mkdir -p "$ICON_DIR/scalable/actions"
for n in view-app-grid-symbolic view-app-grid-user-symbolic view-app-grid-ubuntu-symbolic \
         view-app-grid-gdm-symbolic view-app-grid-unlock-dialog-symbolic; do
    cp /usr/share/atherium/start-symbolic.svg "$ICON_DIR/scalable/actions/$n.svg"
done
cat > "$ICON_DIR/index.theme" <<EOF
[Icon Theme]
Name=Atherium
Comment=Iconos de Atherium (logo en el boton de aplicaciones)
Inherits=$BASE_ICONS,Yaru,Adwaita,hicolor
Directories=scalable/actions

[scalable/actions]
Context=Actions
Size=16
MinSize=1
MaxSize=512
Type=Scalable
EOF
gtk-update-icon-cache -f "$ICON_DIR" >/dev/null 2>&1 || true

echo "Temas elegidos: gtk=$GTK_THEME shell=$SHELL_THEME iconos=Atherium(base $BASE_ICONS) cursor=$CURSOR_THEME navegador=$BROWSER_DESKTOP"

# ---- Sustituir marcadores de la configuracion de GNOME ----
sed -i "s/@GTK_THEME@/$GTK_THEME/g; s/@SHELL_THEME@/$SHELL_THEME/g; s/@CURSOR_THEME@/$CURSOR_THEME/g; s/@BROWSER_DESKTOP@/$BROWSER_DESKTOP/g" \
    /etc/dconf/db/local.d/00-atherium

mkdir -p /usr/share/icons/default
printf '[Icon Theme]\nInherits=%s\n' "$CURSOR_THEME" > /usr/share/icons/default/index.theme

# ---- dconf: valores por defecto del sistema y pantalla de inicio de sesion (GDM) ----
mkdir -p /etc/dconf/profile /etc/dconf/db/gdm.d
printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
cat > /etc/dconf/db/gdm.d/00-atherium <<EOF
[org/gnome/login-screen]
logo='/usr/share/pixmaps/atherium-logo.png'
disable-user-list=false

[org/gnome/desktop/interface]
icon-theme='Atherium'
cursor-theme='$CURSOR_THEME'
color-scheme='prefer-dark'
EOF
dconf update || true

# ---- Shell: neofetch al abrir una terminal interactiva ----
cat >> /etc/skel/.bashrc <<'EOF'

# Atherium: mostrar el logo al abrir la terminal
if [ -t 1 ] && command -v neofetch >/dev/null 2>&1 && [ -z "$ATHERIUM_NEOFETCH_SHOWN" ]; then
    export ATHERIUM_NEOFETCH_SHOWN=1
    neofetch
fi
alias ll='ls -lah --color=auto'
EOF

# ---- Identidad del sistema: Atherium (al final, para no confundir a las herramientas de apt) ----
cat > /etc/os-release <<'EOF'
PRETTY_NAME="Atherium"
NAME="Atherium"
VERSION_ID="1.0"
VERSION="1.0 (Nebula)"
VERSION_CODENAME=noble
ID=atherium
ID_LIKE="ubuntu debian"
UBUNTU_CODENAME=noble
HOME_URL="https://github.com/AkaV1/Atherium"
SUPPORT_URL="https://github.com/AkaV1/Atherium"
BUG_REPORT_URL="https://github.com/AkaV1/Atherium"
EOF
echo "Atherium 1.0 \\n \\l" > /etc/issue
echo "Atherium 1.0" > /etc/issue.net
# lsb-release se deja con el codename "noble" (lo usan add-apt-repository y otras herramientas)
sed -i 's/^DISTRIB_DESCRIPTION=.*/DISTRIB_DESCRIPTION="Atherium 1.0 (Ubuntu 24.04)"/' /etc/lsb-release 2>/dev/null || true
echo "atherium" > /etc/hostname
