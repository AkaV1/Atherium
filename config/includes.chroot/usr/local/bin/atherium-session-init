#!/bin/sh
# Atherium: mejora opcional del compositor.
# Por defecto xfwm4 ya compone (transparencias basicas). En hardware real se
# cambia por picom (blur + esquinas redondeadas) y si picom falla, se vuelve a xfwm4.

CONF="$HOME/.config/picom/picom.conf"
LOG="$HOME/.cache/atherium-session.log"
mkdir -p "$HOME/.cache"
: > "$LOG"

enable_xfwm4() {
    xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s true >>"$LOG" 2>&1 \
        || xfconf-query -c xfwm4 -p /general/use_compositing -s true >>"$LOG" 2>&1
}

if systemd-detect-virt -q 2>/dev/null; then
    echo "VM detectada: se usa el compositor de xfwm4" >> "$LOG"
    enable_xfwm4
    exit 0
fi

if ! command -v picom >/dev/null 2>&1; then
    echo "picom no instalado: se usa el compositor de xfwm4" >> "$LOG"
    enable_xfwm4
    exit 0
fi

# Hardware real: probar picom con GLX
sleep 3
xfconf-query -c xfwm4 -p /general/use_compositing -s false >>"$LOG" 2>&1
pkill -x picom 2>/dev/null
picom --config "$CONF" --backend glx >>"$LOG" 2>&1 &
sleep 3
if pgrep -x picom >/dev/null 2>&1; then
    echo "compositor: picom (glx)" >> "$LOG"
else
    echo "picom fallo, se vuelve al compositor de xfwm4" >> "$LOG"
    enable_xfwm4
fi
