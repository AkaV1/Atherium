QWidget { font-family: "Roboto"; font-size: 14px; color: #e6e0e9; }
QMainWindow, QDialog, #mainApp { background-color: #1d1b20; }
#sidebarApp, #logoApp { background-color: #141218; }
QPushButton { background-color: #4a4458; color: #e6e0e9; border: none; border-radius: 18px; padding: 9px 22px; }
QPushButton:hover { background-color: #5d5670; }
QPushButton:default, QPushButton:focus { background-color: #d0bcff; color: #381e72; }
QPushButton:disabled { background-color: #2b2930; color: #79747e; }
QLineEdit, QComboBox, QListView, QTreeView, QTableView, QSpinBox { background-color: #2b2930; border: 1px solid #49454f; border-radius: 10px; padding: 6px; selection-background-color: #6750a4; }
QProgressBar { background-color: #2b2930; border: none; border-radius: 6px; text-align: center; height: 12px; }
QProgressBar::chunk { background-color: #d0bcff; border-radius: 6px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background-color: #d0bcff; }
QToolTip { background-color: #2b2930; color: #e6e0e9; border: 1px solid #49454f; }
