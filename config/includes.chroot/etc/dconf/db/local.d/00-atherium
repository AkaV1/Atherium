[org/gnome/desktop/interface]
gtk-theme='@GTK_THEME@'
icon-theme='Atherium'
cursor-theme='@CURSOR_THEME@'
font-name='Roboto 10'
document-font-name='Roboto 10'
monospace-font-name='Fira Code 10'
color-scheme='prefer-dark'
enable-hot-corners=false
clock-show-weekday=true
enable-animations=true

# Botones de ventana a la derecha: ▲ minimizar, ▼ maximizar, ◆ cerrar
[org/gnome/desktop/wm/preferences]
button-layout=':minimize,maximize,close'
titlebar-font='Roboto Medium 10'

[org/gnome/mutter]
edge-tiling=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/atherium/wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/atherium/wallpaper.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/atherium/login.png'
picture-options='zoom'

[org/gnome/desktop/input-sources]
sources=[('xkb', 'latam')]

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', '@BROWSER_DESKTOP@', 'io.github.kolunmi.Bazaar.desktop', 'org.gnome.Terminal.desktop', 'libreoffice-writer.desktop', 'libreoffice-calc.desktop', 'libreoffice-impress.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Settings.desktop', 'atherium-rendimiento.desktop', 'atherium-installer.desktop']

[org/gnome/shell/extensions/user-theme]
name='@SHELL_THEME@'

