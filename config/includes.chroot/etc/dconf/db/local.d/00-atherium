[org/gnome/desktop/interface]
gtk-theme='@GTK_THEME@'
icon-theme='Atherium'
cursor-theme='@CURSOR_THEME@'
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='Fira Code 10'
color-scheme='prefer-dark'
enable-hot-corners=false
clock-show-weekday=true

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
titlebar-font='Inter Bold 10'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/atherium/wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/atherium/wallpaper.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/atherium/wallpaper.png'
picture-options='zoom'

[org/gnome/desktop/input-sources]
sources=[('xkb', 'latam')]

[org/gnome/shell]
enabled-extensions=['ubuntu-dock@ubuntu.com', 'user-theme@gnome-shell-extensions.gcampax.github.com']
favorite-apps=['org.gnome.Nautilus.desktop', '@BROWSER_DESKTOP@', 'org.gnome.Terminal.desktop', 'libreoffice-writer.desktop', 'libreoffice-calc.desktop', 'libreoffice-impress.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Settings.desktop', 'calamares.desktop']

[org/gnome/shell/extensions/user-theme]
name='@SHELL_THEME@'

# Dock inferior, transparente, estilo macOS. El boton de apps usa el logo de Atherium
# (icono view-app-grid-symbolic del tema de iconos "Atherium") y va al principio.
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
dash-max-icon-size=56
transparency-mode='FIXED'
background-opacity=0.0
custom-background-color=false
apply-custom-theme=false
running-indicator-style='DOTS'
show-apps-at-top=true
show-trash=false
show-mounts=false
click-action='focus-or-previews'

# Terminal translucida con la paleta de Atherium
[org/gnome/terminal/legacy/profiles:]
default='b1dcc9dd-5262-4d8d-a863-c897e6d979b9'
list=['b1dcc9dd-5262-4d8d-a863-c897e6d979b9']

[org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9]
visible-name='Atherium'
use-theme-colors=false
foreground-color='rgb(230,233,255)'
background-color='rgb(11,11,36)'
use-transparent-background=true
background-transparency-percent=22
use-system-font=false
font='Fira Code 11'
audible-bell=false
