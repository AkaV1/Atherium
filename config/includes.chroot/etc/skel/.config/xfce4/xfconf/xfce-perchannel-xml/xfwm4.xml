<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <!-- xfwm4 compone desde el primer arranque (funciona en VM). En hardware real
         atherium-session-init lo cambia por picom (blur + esquinas redondeadas). -->
    <property name="use_compositing" type="bool" value="true"/>
    <property name="frame_opacity" type="int" value="85"/>
    <property name="inactive_opacity" type="int" value="88"/>
    <property name="popup_opacity" type="int" value="100"/>
    <property name="move_opacity" type="int" value="100"/>
    <property name="resize_opacity" type="int" value="100"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="show_popup_shadow" type="bool" value="false"/>
    <property name="show_dock_shadow" type="bool" value="false"/>
    <property name="shadow_opacity" type="int" value="60"/>
    <property name="theme" type="string" value="@XFWM_THEME@"/>
    <property name="title_alignment" type="string" value="center"/>
    <property name="button_layout" type="string" value="CHM|"/>
    <property name="show_app_icon" type="bool" value="false"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="easy_click" type="string" value="Alt"/>
    <property name="workspace_count" type="int" value="2"/>
  </property>
</channel>
