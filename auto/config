#!/bin/sh
# Atherium - configuracion de live-build (base: Ubuntu 24.04 LTS "noble")
set -e

lb config noauto \
    --mode ubuntu \
    --distribution noble \
    --architectures amd64 \
    --linux-flavours generic \
    --linux-packages "linux-image" \
    --archive-areas "main restricted universe multiverse" \
    --binary-images iso-hybrid \
    --debian-installer none \
    --initramfs casper \
    --security true \
    --updates true \
    --apt-recommends true \
    --memtest none \
    --iso-application "Atherium" \
    --iso-publisher "Atherium; https://github.com/AkaV1/Atherium" \
    --iso-volume "ATHERIUM" \
    --image-name "atherium" \
    --bootappend-live "boot=casper quiet splash username=atherium userfullname=Atherium hostname=atherium locale=es_MX.UTF-8 keyboard-configuration/layoutcode=latam ---" \
    "${@}"
